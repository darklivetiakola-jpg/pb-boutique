generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?
  googleId     String?   @unique
  firstName    String
  lastName     String
  phone        String?
  role         Role      @default(CUSTOMER)
  address      String?
  city         String    @default("Abidjan")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  orders       Order[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Category {
  id       String    @id @default(uuid())
  name     String
  slug     String    @unique
  products Product[]
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id               String         @id @default(uuid())
  name             String
  slug             String         @unique
  description      String?
  material         String?
  fit              String?
  care             String?
  origin           String?
  basePrice        Int
  compareAtPrice   Int?
  status           ProductStatus  @default(DRAFT)
  isFeatured       Boolean        @default(false)
  category         Category?      @relation(fields: [categoryId], references: [id])
  categoryId       String?
  images           ProductImage[]
  variants         ProductVariant[]
  orderItems       OrderItem[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model ProductImage {
  id        String  @id @default(uuid())
  url       String
  altText   String?
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
}

model ProductVariant {
  id                String      @id @default(uuid())
  size              String
  color             String      @default("Standard")
  sku               String      @unique
  stock             Int         @default(0)
  lowStockThreshold Int         @default(5)
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId         String
  cartItems         CartItem[]
  orderItems        OrderItem[]

  @@unique([productId, size, color])
}

model Cart {
  id        String     @id @default(uuid())
  sessionKey String    @unique
  userId    String?
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(uuid())
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  variantId String
  quantity  Int            @default(1)

  @@unique([cartId, variantId])
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id              String      @id @default(uuid())
  reference       String      @unique
  user            User?       @relation(fields: [userId], references: [id])
  userId          String?
  fullName        String
  phone           String
  email           String?
  deliveryAddress String
  city            String      @default("Abidjan")
  status          OrderStatus @default(PENDING)
  totalAmount     Int
  deliveryFee     Int         @default(0)
  deliveryZone    String?
  items           OrderItem[]
  payment         Payment?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id          String         @id @default(uuid())
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  variantId   String
  product     Product        @relation(fields: [productId], references: [id])
  productId   String
  productName String
  size        String
  unitPrice   Int
  quantity    Int            @default(1)
}

enum PaymentStatus {
  INITIATED
  ACCEPTED
  REFUSED
  CANCELLED
}

model Payment {
  id            String        @id @default(uuid())
  order         Order         @relation(fields: [orderId], references: [id])
  orderId       String        @unique
  transactionId String        @unique
  method        String?
  status        PaymentStatus @default(INITIATED)
  amount        Int
  rawResponse   Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum PostType {
  ARTICLE
  PROMOTION
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Post {
  id          String     @id @default(uuid())
  type        PostType   @default(ARTICLE)
  title       String
  slug        String     @unique
  excerpt     String?
  content     String?
  coverImage  String?
  status      PostStatus @default(DRAFT)
  publishAt   DateTime?
  discountPct Int?
  ctaLabel    String?
  ctaUrl      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model DeliveryZone {
  id        String   @id @default(uuid())
  name      String   @unique
  fee       Int
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
}
