NODE_ENV=development
PORT=4000

# PostgreSQL (Neon, Railway, Render…) — NE JAMAIS committer la vraie URL
DATABASE_URL="postgresql://user:password@host:5432/pb_boutique?sslmode=require"

# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=remplace-moi-par-96-caracteres-hex
JWT_REFRESH_SECRET=remplace-moi-par-une-autre-valeur-de-96-caracteres
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# URLs des fronts (plusieurs valeurs possibles séparées par une virgule)
FRONTEND_URL=http://localhost:5500
ADMIN_URL=http://localhost:5174

# Cookies : "lax" si boutique + API partagent le même domaine parent (recommandé)
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.mondomaine.ci

GOOGLE_CLIENT_ID=ton-client-id.apps.googleusercontent.com

# CinetPay
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2
CINETPAY_NOTIFY_URL=http://localhost:4000/api/orders/webhook
CINETPAY_RETURN_URL=http://localhost:5500/confirmation

# --- Alertes de nouvelle commande sur Telegram (optionnel, gratuit) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Livraison offerte à partir de ce montant (FCFA) ---
FREE_SHIPPING_FROM=100000
