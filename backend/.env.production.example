# ===== Variables à saisir dans Render (Environment) =====
NODE_ENV=production
DATABASE_URL=<nouvelle URL Neon>        # retirer "&channel_binding=require" si erreur de connexion
JWT_ACCESS_SECRET=<96 caractères générés>
JWT_REFRESH_SECRET=<96 autres caractères générés>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# URL EXACTES de Vercel, sans "/" final
FRONTEND_URL=https://VOTRE-BOUTIQUE.vercel.app
ADMIN_URL=https://VOTRE-ADMIN.vercel.app

# Mode "proxy Vercel" (sans nom de domaine) : cookies lax, PAS de COOKIE_DOMAIN
COOKIE_SAMESITE=lax

UPLOAD_DIR=/var/data/uploads            # chemin du Disk Render

GOOGLE_CLIENT_ID=990781095347-4jo8isqprvqi6oaig7fa4idooa3e590k.apps.googleusercontent.com
CINETPAY_API_KEY=<clé CinetPay>
CINETPAY_SITE_ID=<site id>
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2
CINETPAY_NOTIFY_URL=https://VOTRE-API.onrender.com/api/orders/webhook
CINETPAY_RETURN_URL=https://VOTRE-BOUTIQUE.vercel.app/confirmation
